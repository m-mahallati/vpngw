#!/usr/bin/env bash
# vpngw - turn a Raspberry Pi into an on-demand LAN VPN gateway.
#
#   vpngw on        enable gateway + DNS  (LAN clients route through the tunnel)
#   vpngw off       tear everything down
#   vpngw status    show current state
#   vpngw restart   off then on
#   vpngw test      verify the exit IP actually goes through the tunnel
#   vpngw block <ip> / unblock <ip>     deny a client entirely
#   vpngw bypass <ip> / unbypass <ip>   let a client skip the tunnel
#   vpngw clients   show both lists
#   vpngw enable-boot / disable-boot
#
# Config lives in /etc/vpngw.conf

set -uo pipefail

CONF="${VPNGW_CONF:-/etc/vpngw.conf}"
DNSMASQ_CONF=/etc/dnsmasq.d/vpngw.conf
SERVICE=vpn-gateway.service
WATCHDOG_SERVICE=vpngw-watchdog.timer
WEB_SERVICE=vpngw-web.service
WEB_PASSWD_FILE=/etc/vpngw.passwd
STATE_DIR=/var/lib/vpngw

# ----------------------------------------------------------------------------
# defaults (override in /etc/vpngw.conf)
# ----------------------------------------------------------------------------
LAN_IF=""                       # auto-detected if empty (e.g. eth0)
VPN_IF="xvpn-tun0"              # the VPN tunnel interface
LAN_CIDR=""                     # auto-detected if empty (e.g. 192.168.1.0/24)
LAN_GATEWAY=""                  # your router. Auto-detected; needed for bypass
UPSTREAM_DNS="1.1.1.1 9.9.9.9"  # resolvers dnsmasq forwards to (through the tunnel)
KILL_SWITCH=yes                 # drop client traffic when the tunnel is down
DNS_LEAK_GUARD=yes              # also block the Pi's own queries to UPSTREAM_DNS outside the tunnel
BLOCK_IPV6=yes                  # stop clients leaking over IPv6
DNS_CACHE_SIZE=1000
DNSMASQ_SERVICE=dnsmasq

# Per-client exceptions (space-separated IPs or CIDRs, managed by the CLI)
BLOCK_IPS=""                    # denied entirely — no internet through the Pi at all
BYPASS_IPS=""                   # skip the tunnel, go out the normal uplink instead

# Local accounts on the Pi whose outbound traffic is dropped. They can still
# log in over SSH — only what they try to send out is blocked.
BLOCK_USERS=""
SSH_PORT=22                     # exempted so blocking never kills a live session

# --- watchdog -------------------------------------------------------------
# Command that brings your VPN back up, e.g. "xvpn connect". Left empty the
# watchdog still detects and logs a dead tunnel, but won't try to fix it.
VPN_RESTART_CMD=""
WATCHDOG_PING_HOST="1.1.1.1"    # pinged through the tunnel to prove it works
WATCHDOG_FAILS_BEFORE_ACTION=2  # consecutive failed checks before restarting
WATCHDOG_COOLDOWN=120           # seconds to wait after a restart before rechecking

# --- policy routing (bypass) ----------------------------------------------
BYPASS_TABLE=51                 # routing table id used for bypassed clients
BYPASS_PRIO=100                 # ip rule priority

# --- web dashboard --------------------------------------------------------
WEB_PORT=8088
WEB_BIND=""                     # defaults to the Pi's LAN IP; "0.0.0.0" for all
WEB_USER="admin"

# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

# ----------------------------------------------------------------------------
# helpers
# ----------------------------------------------------------------------------
C_OK=$'\033[32m'; C_BAD=$'\033[31m'; C_WARN=$'\033[33m'; C_DIM=$'\033[2m'; C_OFF=$'\033[0m'
[ -t 1 ] || { C_OK=; C_BAD=; C_WARN=; C_DIM=; C_OFF=; }

log()  { printf '  %s\n' "$*"; }
ok()   { printf '  %s✔%s %s\n' "$C_OK" "$C_OFF" "$*"; }
warn() { printf '  %s!%s %s\n' "$C_WARN" "$C_OFF" "$*"; }
die()  { printf '  %s✘%s %s\n' "$C_BAD" "$C_OFF" "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "run as root (sudo vpngw $*)"; }

have() { command -v "$1" >/dev/null 2>&1; }

iface_exists() { [ -e "/sys/class/net/$1" ]; }

iface_up() {
    iface_exists "$1" || return 1
    [ "$(cat "/sys/class/net/$1/operstate" 2>/dev/null)" = "up" ] ||
        [ "$(cat "/sys/class/net/$1/operstate" 2>/dev/null)" = "unknown" ]
}

detect_lan_if() {
    # first global IPv4 interface that is not a tunnel / loopback
    ip -o -4 addr show scope global 2>/dev/null |
        awk '$2 !~ /^(lo|tun|tap|wg|ppp|xvpn)/ {print $2; exit}'
}

detect_lan_cidr() {
    ip -4 route show dev "$LAN_IF" scope link proto kernel 2>/dev/null |
        awk '{print $1; exit}'
}

lan_ip() {
    ip -o -4 addr show dev "$LAN_IF" scope global 2>/dev/null |
        awk '{print $4; exit}' | cut -d/ -f1
}

vpn_ip() {
    ip -o -4 addr show dev "$VPN_IF" 2>/dev/null | awk '{print $4; exit}'
}

LAN_IP=""

# fills in whatever it can, never fails — used by 'status'
resolve_soft() {
    [ -n "$LAN_IF" ]   || LAN_IF="$(detect_lan_if)"
    if [ -n "$LAN_IF" ] && iface_exists "$LAN_IF"; then
        [ -n "$LAN_CIDR" ] || LAN_CIDR="$(detect_lan_cidr)"
        LAN_IP="$(lan_ip)"
    fi
    return 0
}

# strict version — used by anything that changes state
# The LAN router. Needed for bypass: we can't send a client "out the normal
# uplink" without knowing what the normal next hop is. Once the VPN is up the
# main-table default may point at the tunnel, so try several sources.
detect_lan_gateway() {
    local gw
    # 1. a default route still pinned to the LAN interface (typical when the
    #    VPN client adds 0.0.0.0/1 + 128.0.0.0/1 rather than replacing default)
    gw="$(ip -4 route show default dev "$LAN_IF" 2>/dev/null |
          awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')"
    [ -n "$gw" ] && { printf '%s' "$gw"; return; }

    # 2. anything the VPN stashed away as the original gateway
    gw="$(ip -4 route show table all 2>/dev/null |
          awk -v ifc="$LAN_IF" '$1=="default" && $0 ~ ("dev " ifc) {
              for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}' | head -1)"
    [ -n "$gw" ] && { printf '%s' "$gw"; return; }

    # 3. the DHCP lease the Pi itself got
    gw="$(awk '/option routers/ {print $3; exit}' \
          /var/lib/dhcp/dhclient."$LAN_IF".leases 2>/dev/null | tr -d ';')"
    [ -n "$gw" ] && { printf '%s' "$gw"; return; }

    printf ''
}

resolve_settings() {
    resolve_soft
    [ -n "$LAN_IF" ]       || die "could not detect the LAN interface — set LAN_IF in $CONF"
    iface_exists "$LAN_IF" || die "LAN interface '$LAN_IF' does not exist"
    [ -n "$LAN_CIDR" ]     || die "could not detect the LAN subnet — set LAN_CIDR in $CONF"
    [ -n "$LAN_IP" ]       || die "interface '$LAN_IF' has no IPv4 address"
    have iptables          || die "iptables not found (apt install iptables)"
}

# ----------------------------------------------------------------------------
# firewall (iptables, custom chains so nothing else on the box is touched)
# ----------------------------------------------------------------------------
FWD_CHAIN=VPNGW_FWD
IN_CHAIN=VPNGW_IN
OUT_CHAIN=VPNGW_OUT
NAT_CHAIN=VPNGW_NAT
FWD6_CHAIN=VPNGW_FWD6
ACCT_CHAIN=VPNGW_ACCT

ipt()  { iptables  "$@" 2>/dev/null; }
ipt6() { ip6tables "$@" 2>/dev/null; }

fw_clear() {
    # unhook jumps (loop in case of duplicates), then flush + delete chains
    local n
    n=0; while [ "$n" -lt 64 ] && ipt -C FORWARD -j "$ACCT_CHAIN"; do ipt -D FORWARD -j "$ACCT_CHAIN"; n=$((n+1)); done
    ipt -F "$ACCT_CHAIN"; ipt -X "$ACCT_CHAIN"
    n=0; while [ "$n" -lt 64 ] && ipt -C FORWARD -j "$FWD_CHAIN"; do ipt -D FORWARD -j "$FWD_CHAIN"; n=$((n+1)); done
    n=0; while [ "$n" -lt 64 ] && ipt -C INPUT   -j "$IN_CHAIN";  do ipt -D INPUT   -j "$IN_CHAIN";  n=$((n+1)); done
    n=0; while [ "$n" -lt 64 ] && ipt -C OUTPUT  -j "$OUT_CHAIN"; do ipt -D OUTPUT  -j "$OUT_CHAIN"; n=$((n+1)); done
    n=0; while [ "$n" -lt 64 ] && ipt -t nat -C POSTROUTING -j "$NAT_CHAIN"; do ipt -t nat -D POSTROUTING -j "$NAT_CHAIN"; n=$((n+1)); done
    ipt -F "$FWD_CHAIN"; ipt -X "$FWD_CHAIN"
    ipt -F "$IN_CHAIN";  ipt -X "$IN_CHAIN"
    ipt -F "$OUT_CHAIN"; ipt -X "$OUT_CHAIN"
    ipt -t nat -F "$NAT_CHAIN"; ipt -t nat -X "$NAT_CHAIN"

    if have ip6tables; then
        n=0; while [ "$n" -lt 64 ] && ipt6 -C FORWARD -j "$FWD6_CHAIN"; do ipt6 -D FORWARD -j "$FWD6_CHAIN"; n=$((n+1)); done
        ipt6 -F "$FWD6_CHAIN"; ipt6 -X "$FWD6_CHAIN"
    fi
    return 0
}

fw_apply() {
    fw_clear

    iptables -N "$FWD_CHAIN" || die "cannot create iptables chain — is iptables installed?"
    iptables -N "$IN_CHAIN"
    iptables -N "$OUT_CHAIN"
    iptables -t nat -N "$NAT_CHAIN"

    # --- INPUT: blacklisted clients don't get to use our resolver either -----
    if [ -n "${BLOCK_IPS// /}" ]; then
        for b in $BLOCK_IPS; do
            iptables -A "$IN_CHAIN" -i "$LAN_IF" -s "$b" -p udp --dport 53 -j DROP
            iptables -A "$IN_CHAIN" -i "$LAN_IF" -s "$b" -p tcp --dport 53 -j DROP
        done
        iptables -I INPUT 1 -j "$IN_CHAIN"
    fi

    # --- NAT: masquerade LAN traffic leaving the tunnel ----------------------
    iptables -t nat -A "$NAT_CHAIN" -s "$LAN_CIDR" -o "$VPN_IF" -j MASQUERADE
    iptables -t nat -I POSTROUTING 1 -j "$NAT_CHAIN"

    # --- FORWARD -------------------------------------------------------------
    # 1. blacklisted clients die first, before the conntrack accept, so even
    #    already-established flows stop the moment you block them
    for b in $BLOCK_IPS; do
        iptables -A "$FWD_CHAIN" -i "$LAN_IF" -s "$b" -j DROP
        iptables -A "$FWD_CHAIN" -o "$LAN_IF" -d "$b" -j DROP
    done

    # 2. clamp MSS (non-terminating) so TCP survives the smaller tunnel MTU
    iptables -A "$FWD_CHAIN" -o "$VPN_IF" -p tcp --tcp-flags SYN,RST SYN \
        -j TCPMSS --clamp-mss-to-pmtu

    # 3. return traffic
    iptables -A "$FWD_CHAIN" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

    # 4. bypass clients. route_apply() is what actually diverts them out the
    #    uplink (via policy routing); this rule just permits the result, which
    #    is why it matches -o LAN_IF rather than the tunnel.
    for b in $BYPASS_IPS; do
        iptables -A "$FWD_CHAIN" -i "$LAN_IF" -o "$LAN_IF" -s "$b" -j ACCEPT
    done

    # 5. everyone else goes through the tunnel
    iptables -A "$FWD_CHAIN" -i "$LAN_IF" -o "$VPN_IF" -s "$LAN_CIDR" -j ACCEPT

    if [ "$KILL_SWITCH" = yes ]; then
        # anything from the LAN that did NOT match the tunnel rule above dies here,
        # so when $VPN_IF is missing/down nothing leaks out over the uplink
        iptables -A "$FWD_CHAIN" -i "$LAN_IF" -j DROP
    fi
    iptables -I FORWARD 1 -j "$FWD_CHAIN"

    # --- accounting: one counter rule per direction per known host ----------
    # These rules have no target, so they tally bytes and fall through. Placed
    # ahead of everything else so blocked traffic is counted too.
    iptables -N "$ACCT_CHAIN"
    iptables -I FORWARD 1 -j "$ACCT_CHAIN"
    acct_sync

    # --- routing: divert bypassed clients away from the tunnel --------------
    route_apply

    # --- OUTPUT: traffic the Pi itself generates -----------------------------
    local out_rules=0

    # Exemptions come first and are unconditional: a live SSH session's replies
    # leave sshd with source port 22, so this is what lets a blocked user stay
    # logged in — and what stops you locking yourself out of the Pi.
    if [ -n "${BLOCK_USERS// /}" ]; then
        iptables -A "$OUT_CHAIN" -o lo -j RETURN
        iptables -A "$OUT_CHAIN" -p tcp --sport "$SSH_PORT" -j RETURN
        out_rules=1
    fi

    # don't let our own resolver queries escape the tunnel
    if [ "$KILL_SWITCH" = yes ] && [ "$DNS_LEAK_GUARD" = yes ]; then
        for d in $UPSTREAM_DNS; do
            iptables -A "$OUT_CHAIN" ! -o "$VPN_IF" -d "$d" -p udp --dport 53 -j DROP
            iptables -A "$OUT_CHAIN" ! -o "$VPN_IF" -d "$d" -p tcp --dport 53 -j DROP
        done
        out_rules=1
    fi

    # blocked local accounts
    for u in $BLOCK_USERS; do
        if id -u "$u" >/dev/null 2>&1; then
            iptables -A "$OUT_CHAIN" -m owner --uid-owner "$u" -j DROP
            out_rules=1
        else
            warn "user '$u' no longer exists — skipping"
        fi
    done

    [ "$out_rules" -eq 1 ] && iptables -I OUTPUT 1 -j "$OUT_CHAIN"

    # --- IPv6: block forwarding entirely so clients can't bypass the tunnel --
    if [ "$BLOCK_IPV6" = yes ] && have ip6tables; then
        ip6tables -N "$FWD6_CHAIN" 2>/dev/null
        ip6tables -A "$FWD6_CHAIN" -i "$LAN_IF" -j DROP
        ip6tables -I FORWARD 1 -j "$FWD6_CHAIN"
    fi
}

# ----------------------------------------------------------------------------
# policy routing — what actually makes 'bypass' work
# ----------------------------------------------------------------------------
# Firewall rules can't send a packet somewhere else; the routing decision has
# already happened by the time FORWARD runs. So bypassed clients need their own
# routing table (default via the LAN router) selected by a source-based ip rule.
route_clear() {
    have ip || return 0
    # bounded: this runs as root at boot, so never risk spinning forever if
    # 'ip rule del' reports success without actually removing anything
    local n=0
    while [ "$n" -lt 64 ] && ip rule del priority "$BYPASS_PRIO" 2>/dev/null; do
        n=$((n + 1))
    done
    [ "$n" -ge 64 ] && warn "gave up removing ip rules at priority $BYPASS_PRIO"
    ip route flush table "$BYPASS_TABLE" 2>/dev/null
    return 0
}

route_apply() {
    route_clear
    [ -n "${BYPASS_IPS// /}" ] || return 0

    [ -n "$LAN_GATEWAY" ] || LAN_GATEWAY="$(detect_lan_gateway)"
    if [ -z "$LAN_GATEWAY" ]; then
        warn "cannot find your router's IP — bypass will NOT work"
        warn "set LAN_GATEWAY in $CONF (it's your normal default gateway)"
        return 0
    fi

    # a table that reaches the LAN directly and everything else via the router
    ip route replace "$LAN_CIDR" dev "$LAN_IF" scope link table "$BYPASS_TABLE" 2>/dev/null
    if ! ip route replace default via "$LAN_GATEWAY" dev "$LAN_IF" \
            table "$BYPASS_TABLE" 2>/dev/null; then
        warn "could not install bypass route via $LAN_GATEWAY — bypass will not work"
        return 0
    fi

    local b
    for b in $BYPASS_IPS; do
        ip rule add from "$b" lookup "$BYPASS_TABLE" priority "$BYPASS_PRIO" 2>/dev/null
    done
    return 0
}

# ----------------------------------------------------------------------------
# sysctl
# ----------------------------------------------------------------------------
set_sysctl() {
    sysctl -qw net.ipv4.ip_forward="$1"
    sysctl -qw net.ipv4.conf.all.send_redirects="$2"       2>/dev/null
    sysctl -qw "net.ipv4.conf.$LAN_IF.send_redirects=$2"   2>/dev/null
    # loose reverse-path filtering: packets come in and go out on different ifaces
    sysctl -qw net.ipv4.conf.all.rp_filter="$3"            2>/dev/null
    sysctl -qw "net.ipv4.conf.$LAN_IF.rp_filter=$3"        2>/dev/null
    return 0
}

# ----------------------------------------------------------------------------
# dnsmasq
# ----------------------------------------------------------------------------
dnsmasq_supports() { dnsmasq --help 2>/dev/null | grep -q -- "--$1"; }

dns_port_conflict() {
    # something other than dnsmasq already bound to :53 ?
    if have ss; then
        ss -lunp 2>/dev/null | awk '$5 ~ /:53$/ {print}' | grep -qv dnsmasq
    else
        return 1
    fi
}

dnsmasq_write() {
    have dnsmasq || die "dnsmasq is not installed (apt install dnsmasq)"
    mkdir -p /etc/dnsmasq.d
    {
        echo "# generated by vpngw — do not edit, edit $CONF instead"
        echo "interface=$LAN_IF"
        echo "listen-address=127.0.0.1,$LAN_IP"
        echo "bind-interfaces"
        echo "no-dhcp-interface=$LAN_IF"
        echo "no-resolv"
        echo "no-poll"
        for d in $UPSTREAM_DNS; do echo "server=$d"; done
        echo "cache-size=$DNS_CACHE_SIZE"
        echo "domain-needed"
        echo "bogus-priv"
        echo "stop-dns-rebind"
        echo "rebind-localhost-ok"
        if [ "$BLOCK_IPV6" = yes ] && dnsmasq_supports filter-AAAA; then
            echo "filter-AAAA"
        fi
    } > "$DNSMASQ_CONF"

    if ! dnsmasq --test -C /etc/dnsmasq.conf >/dev/null 2>&1; then
        rm -f "$DNSMASQ_CONF"
        die "dnsmasq rejected the generated config; nothing was changed"
    fi

    dns_port_conflict && warn "another process is listening on port 53 (systemd-resolved?) — dnsmasq may fail to bind"

    systemctl restart "$DNSMASQ_SERVICE" ||
        die "dnsmasq failed to start — see: journalctl -u $DNSMASQ_SERVICE -n 30"
}

dnsmasq_remove() {
    rm -f "$DNSMASQ_CONF"
    if svc_active "$DNSMASQ_SERVICE"; then
        # if dnsmasq was only here for us, stop it; otherwise reload
        systemctl stop "$DNSMASQ_SERVICE" || true
    fi
}

# ----------------------------------------------------------------------------
# commands
# ----------------------------------------------------------------------------
cmd_on() {
    need_root on
    resolve_settings

    printf '\n  %sStarting VPN gateway%s\n' "$C_DIM" "$C_OFF"

    if ! iface_exists "$VPN_IF"; then
        warn "tunnel '$VPN_IF' is not up yet — rules installed, clients stay blocked until it appears"
    elif ! iface_up "$VPN_IF"; then
        warn "tunnel '$VPN_IF' exists but is down"
    fi

    set_sysctl 1 0 2
    ok "ip_forward enabled"

    fw_apply
    ok "firewall rules installed (kill switch: $KILL_SWITCH, ipv6 blocked: $BLOCK_IPV6)"

    dnsmasq_write
    ok "dnsmasq serving DNS on $LAN_IP:53 → ${UPSTREAM_DNS// /, }"

    if [ "$KILL_SWITCH" = yes ] && [ "$DNS_LEAK_GUARD" = yes ]; then
        for d in $UPSTREAM_DNS; do
            if grep -q "^nameserver[[:space:]]*$d\$" /etc/resolv.conf 2>/dev/null; then
                warn "the Pi's own /etc/resolv.conf uses $d, which the leak guard blocks when the tunnel is down"
                warn "point /etc/resolv.conf at 127.0.0.1 or set DNS_LEAK_GUARD=no in $CONF"
                break
            fi
        done
    fi

    printf '\n'
    log "Point your LAN devices at:"
    log "  gateway : $LAN_IP"
    log "  dns     : $LAN_IP"
    printf '\n'
}

cmd_off() {
    need_root off
    resolve_settings

    printf '\n  %sStopping VPN gateway%s\n' "$C_DIM" "$C_OFF"
    fw_clear;        ok "firewall rules removed"
    route_clear;     ok "policy routes removed"
    dnsmasq_remove;  ok "dnsmasq stopped, config removed"
    set_sysctl 0 1 0
    ok "ip_forward disabled"
    printf '\n'
    warn "clients still pointing at this Pi will lose internet until you change them back"
    printf '\n'
}

state_is_on() {
    have iptables || return 1
    iptables -S FORWARD 2>/dev/null | grep -q -- "-j $FWD_CHAIN"
}

svc_active()  { have systemctl && systemctl is-active  --quiet "$1" 2>/dev/null; }
svc_enabled() { have systemctl && systemctl is-enabled --quiet "$1" 2>/dev/null; }

cmd_status() {
    resolve_soft

    local st_col st_txt
    if state_is_on; then st_col="$C_OK"; st_txt="ON"; else st_col="$C_BAD"; st_txt="OFF"; fi

    printf '\n  %sVPN GATEWAY: %s%s%s\n\n' "$C_DIM" "$st_col" "$st_txt" "$C_OFF"

    printf '  %-22s %s\n' "LAN interface"  "${LAN_IF:-?} (${LAN_IP:-no ip})"
    printf '  %-22s %s\n' "LAN subnet"     "${LAN_CIDR:-?}"

    if iface_up "$VPN_IF"; then
        printf '  %-22s %s%s%s %s\n' "Tunnel" "$C_OK" "$VPN_IF up" "$C_OFF" "$(vpn_ip)"
    elif iface_exists "$VPN_IF"; then
        printf '  %-22s %s%s%s\n' "Tunnel" "$C_WARN" "$VPN_IF exists but down" "$C_OFF"
    else
        printf '  %-22s %s%s%s\n' "Tunnel" "$C_BAD" "$VPN_IF missing" "$C_OFF"
    fi

    printf '  %-22s %s\n' "ip_forward" "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)"

    if svc_active "$DNSMASQ_SERVICE"; then
        printf '  %-22s %sactive%s (%s)\n' "dnsmasq" "$C_OK" "$C_OFF" "${UPSTREAM_DNS// /, }"
    else
        printf '  %-22s %sinactive%s\n' "dnsmasq" "$C_BAD" "$C_OFF"
    fi

    printf '  %-22s %s\n' "Kill switch"    "$KILL_SWITCH"
    printf '  %-22s %s\n' "DNS leak guard" "$DNS_LEAK_GUARD"
    printf '  %-22s %s\n' "IPv6 blocked"   "$BLOCK_IPV6"

    if svc_enabled "$SERVICE"; then
        printf '  %-22s %s\n' "Start at boot" "yes"
    else
        printf '  %-22s %s\n' "Start at boot" "no"
    fi

    if state_is_on; then
        printf '\n  %sTraffic counters%s\n' "$C_DIM" "$C_OFF"
        iptables -vnL "$FWD_CHAIN" 2>/dev/null | tail -n +3 | sed 's/^/  /'
        printf '\n  %sNAT%s\n' "$C_DIM" "$C_OFF"
        iptables -t nat -vnL "$NAT_CHAIN" 2>/dev/null | tail -n +3 | sed 's/^/  /'
    fi
    printf '\n'
}

cmd_test() {
    resolve_settings
    printf '\n'
    if ! iface_up "$VPN_IF"; then
        die "tunnel $VPN_IF is not up"
    fi
    have curl || die "curl not installed"

    local direct tunnel
    tunnel="$(curl -s --max-time 8 --interface "$VPN_IF" https://api.ipify.org || true)"
    direct="$(curl -s --max-time 8 --interface "$LAN_IF" https://api.ipify.org || true)"

    printf '  %-22s %s\n' "exit IP via $VPN_IF" "${tunnel:-unreachable}"
    printf '  %-22s %s\n' "exit IP via $LAN_IF" "${direct:-unreachable/blocked}"
    printf '\n'
    if [ -n "$tunnel" ] && [ "$tunnel" != "$direct" ]; then
        ok "tunnel is carrying traffic to a different exit IP"
    else
        warn "could not confirm the tunnel is changing your exit IP"
    fi

    if state_is_on; then
        local r
        r="$(dig +short +time=3 +tries=1 @"$LAN_IP" example.com 2>/dev/null | head -1)"
        [ -n "$r" ] && ok "DNS via $LAN_IP works (example.com → $r)" \
                    || warn "DNS query to $LAN_IP failed (install dnsutils to test, or check dnsmasq)"
    fi
    printf '\n'
}

# ----------------------------------------------------------------------------
# per-client byte accounting
# ----------------------------------------------------------------------------
# Add a counter rule pair for any LAN host we know about but aren't counting
# yet. Cheap and idempotent — safe to call as often as you like.
acct_sync() {
    iptables -L "$ACCT_CHAIN" -n >/dev/null 2>&1 || return 0
    local known ip
    known="$(iptables -S "$ACCT_CHAIN" 2>/dev/null)"
    for ip in $(acct_hosts); do
        printf '%s' "$known" | grep -q -- "-s $ip/32" || iptables -A "$ACCT_CHAIN" -s "$ip"
        printf '%s' "$known" | grep -q -- "-d $ip/32" || iptables -A "$ACCT_CHAIN" -d "$ip"
    done
}

# hosts worth counting: anything in the ARP table plus anything we have a rule for
acct_hosts() {
    {
        ip -4 neigh show dev "$LAN_IF" 2>/dev/null |
            awk '$3 == "lladdr" && $NF != "FAILED" {print $1}'
        for i in $BLOCK_IPS $BYPASS_IPS; do printf '%s\n' "${i%%/*}"; done
    } | sort -u
}

# emit "ip up_bytes down_bytes" per host
acct_dump() {
    # NB: these rules have no target, so the target column is blank and awk's
    # field numbers shift. Read source/destination from the end instead.
    iptables -vnxL "$ACCT_CHAIN" 2>/dev/null | awk '
        NR<3 || NF<6 {next}
        {
            bytes=$2; src=$(NF-1); dst=$NF
            if (src != "0.0.0.0/0") { sub("/32","",src); up[src]+=bytes; seen[src]=1 }
            if (dst != "0.0.0.0/0") { sub("/32","",dst); down[dst]+=bytes; seen[dst]=1 }
        }
        END { for (h in seen) printf "%s %d %d\n", h, up[h]+0, down[h]+0 }'
}

cmd_acct() {
    need_root
    resolve_settings
    case "${1:-show}" in
        sync)  acct_sync; ok "accounting rules synced" ;;
        reset) iptables -Z "$ACCT_CHAIN" 2>/dev/null && ok "counters zeroed" ;;
        *)
            state_is_on || die "gateway is off — no counters to show"
            printf '\n  %-16s %12s %12s\n' "CLIENT" "UP" "DOWN"
            printf '  %s\n' "$(printf '─%.0s' $(seq 1 42))"
            acct_dump | sort -t. -k4 -n | while read -r h u d; do
                printf '  %-16s %12s %12s\n' "$h" "$(human "$u")" "$(human "$d")"
            done
            printf '\n' ;;
    esac
}

human() {
    awk -v b="$1" 'BEGIN{
        split("B KB MB GB TB", u, " "); i=1
        while (b >= 1024 && i < 5) { b/=1024; i++ }
        printf (i==1 ? "%d %s" : "%.1f %s"), b, u[i]
    }'
}

# ----------------------------------------------------------------------------
# watchdog — notice a dead tunnel and bring it back
# ----------------------------------------------------------------------------
tunnel_healthy() {
    iface_up "$VPN_IF" || return 1
    ping -c1 -W3 -I "$VPN_IF" "$WATCHDOG_PING_HOST" >/dev/null 2>&1
}

cmd_watchdog_check() {
    need_root
    resolve_settings
    mkdir -p "$STATE_DIR"
    local fail_file="$STATE_DIR/watchdog.fails" last_file="$STATE_DIR/watchdog.last"
    local fails=0 last=0 now
    now="$(date +%s)"
    [ -f "$fail_file" ] && fails="$(cat "$fail_file")"
    [ -f "$last_file" ] && last="$(cat "$last_file")"

    # nothing to guard if the gateway isn't running
    if ! state_is_on; then
        echo 0 > "$fail_file"
        echo "gateway is off — nothing to watch"
        return 0
    fi

    if tunnel_healthy; then
        [ "$fails" -gt 0 ] && echo "tunnel recovered after $fails failed check(s)"
        echo 0 > "$fail_file"
        return 0
    fi

    fails=$((fails + 1))
    echo "$fails" > "$fail_file"
    echo "tunnel check FAILED ($fails/$WATCHDOG_FAILS_BEFORE_ACTION) — $VPN_IF unreachable"

    [ "$fails" -ge "$WATCHDOG_FAILS_BEFORE_ACTION" ] || return 0

    if [ -z "$VPN_RESTART_CMD" ]; then
        echo "VPN_RESTART_CMD is empty — cannot reconnect automatically. Set it in $CONF"
        return 0
    fi

    if [ $((now - last)) -lt "$WATCHDOG_COOLDOWN" ]; then
        echo "still in cooldown ($((WATCHDOG_COOLDOWN - (now - last)))s left) — not restarting yet"
        return 0
    fi

    echo "running: $VPN_RESTART_CMD"
    echo "$now" > "$last_file"
    echo 0 > "$fail_file"
    if eval "$VPN_RESTART_CMD"; then
        echo "restart command finished ok"
    else
        echo "restart command exited non-zero"
    fi
}

cmd_watchdog() {
    case "${1:-status}" in
        on|start|enable)
            need_root
            [ -n "$VPN_RESTART_CMD" ] || warn "VPN_RESTART_CMD is empty — set it in $CONF or this only logs"
            systemctl enable --now "$WATCHDOG_SERVICE" && ok "watchdog enabled" ;;
        off|stop|disable)
            need_root
            systemctl disable --now "$WATCHDOG_SERVICE" && ok "watchdog disabled" ;;
        status|*)
            printf '\n'
            if svc_enabled "$WATCHDOG_SERVICE"; then
                printf '  %-22s %senabled%s\n' "watchdog" "$C_OK" "$C_OFF"
            else
                printf '  %-22s %sdisabled%s\n' "watchdog" "$C_BAD" "$C_OFF"
            fi
            printf '  %-22s %s\n' "restart command" "${VPN_RESTART_CMD:-(unset)}"
            printf '  %-22s %s\n' "ping target" "$WATCHDOG_PING_HOST"
            printf '  %-22s %s\n' "fails before action" "$WATCHDOG_FAILS_BEFORE_ACTION"
            [ -f "$STATE_DIR/watchdog.fails" ] &&
                printf '  %-22s %s\n' "current fail count" "$(cat "$STATE_DIR/watchdog.fails")"
            if [ -f "$STATE_DIR/watchdog.last" ]; then
                printf '  %-22s %s\n' "last restart" \
                    "$(date -d "@$(cat "$STATE_DIR/watchdog.last")" 2>/dev/null || echo unknown)"
            fi
            printf '\n  %srecent activity%s\n' "$C_DIM" "$C_OFF"
            journalctl -u vpngw-watchdog.service -n 8 --no-pager -o cat 2>/dev/null | sed 's/^/    /' ||
                log "(no journal available)"
            printf '\n' ;;
    esac
}

# ----------------------------------------------------------------------------
# web dashboard
# ----------------------------------------------------------------------------
cmd_web() {
    case "${1:-status}" in
        on|start)
            need_root
            [ -f "$WEB_PASSWD_FILE" ] || die "no password set — run: vpngw web-passwd"
            systemctl enable --now "$WEB_SERVICE" || die "failed to start $WEB_SERVICE"
            resolve_soft
            ok "dashboard running at http://${WEB_BIND:-$LAN_IP}:$WEB_PORT" ;;
        off|stop)
            need_root
            systemctl disable --now "$WEB_SERVICE" && ok "dashboard stopped" ;;
        status|*)
            resolve_soft
            printf '\n'
            if svc_active "$WEB_SERVICE"; then
                printf '  %-22s %srunning%s  http://%s:%s\n' "dashboard" "$C_OK" "$C_OFF" \
                    "${WEB_BIND:-$LAN_IP}" "$WEB_PORT"
            else
                printf '  %-22s %sstopped%s\n' "dashboard" "$C_BAD" "$C_OFF"
            fi
            printf '  %-22s %s\n' "user" "$WEB_USER"
            [ -f "$WEB_PASSWD_FILE" ] && printf '  %-22s %s\n' "password" "set" \
                                      || printf '  %-22s %snot set%s — run: vpngw web-passwd\n' \
                                         "password" "$C_WARN" "$C_OFF"
            printf '\n' ;;
    esac
}

cmd_web_passwd() {
    need_root
    have python3 || die "python3 is required for the dashboard"
    local p1 p2
    read -rsp "  New dashboard password for '$WEB_USER': " p1; echo
    read -rsp "  Repeat: " p2; echo
    [ -n "$p1" ] || die "password cannot be empty"
    [ "$p1" = "$p2" ] || die "passwords do not match"

    VPNGW_PW="$p1" python3 - "$WEB_PASSWD_FILE" <<'PY' || die "failed to write password file"
import hashlib, os, sys
pw = os.environ["VPNGW_PW"].encode()
salt = os.urandom(16).hex()
h = hashlib.pbkdf2_hmac("sha256", pw, salt.encode(), 100_000).hex()
with open(sys.argv[1], "w") as f:
    f.write(f"{salt}${h}\n")
PY
    chmod 600 "$WEB_PASSWD_FILE"
    ok "password saved to $WEB_PASSWD_FILE"
    svc_active "$WEB_SERVICE" && { systemctl restart "$WEB_SERVICE"; log "dashboard restarted"; }
    return 0
}

# ----------------------------------------------------------------------------
# doctor — preflight checks
# ----------------------------------------------------------------------------
DOC_FAIL=0
DOC_WARN=0
d_ok()   { printf '  %s✔%s %-34s %s\n' "$C_OK"   "$C_OFF" "$1" "${2:-}"; }
d_warn() { printf '  %s!%s %-34s %s\n' "$C_WARN" "$C_OFF" "$1" "${2:-}"; DOC_WARN=$((DOC_WARN+1)); }
d_bad()  { printf '  %s✘%s %-34s %s\n' "$C_BAD"  "$C_OFF" "$1" "${2:-}"; DOC_FAIL=$((DOC_FAIL+1)); }

cmd_doctor() {
    resolve_soft
    printf '\n  %sVPNGW DOCTOR%s\n\n' "$C_DIM" "$C_OFF"

    printf '  %sdependencies%s\n' "$C_DIM" "$C_OFF"
    for t in iptables ip sysctl systemctl; do
        have "$t" && d_ok "$t" || d_bad "$t" "missing — apt install ${t/ip/iproute2}"
    done
    have dnsmasq && d_ok "dnsmasq" "$(dnsmasq --version 2>/dev/null | head -1 | awk '{print $3}')" \
                 || d_bad "dnsmasq" "missing — apt install dnsmasq"
    have curl    && d_ok "curl"    || d_warn "curl"    "missing — 'vpngw test' won't work"
    have dig     && d_ok "dig"     || d_warn "dig"     "missing — apt install dnsutils"
    have python3 && d_ok "python3" || d_warn "python3" "missing — the web dashboard needs it"
    if [ "$BLOCK_IPV6" = yes ]; then
        have ip6tables && d_ok "ip6tables" || d_warn "ip6tables" "missing — IPv6 can't be blocked"
    fi

    printf '\n  %sprivileges%s\n' "$C_DIM" "$C_OFF"
    [ "$(id -u)" -eq 0 ] && d_ok "running as root" \
                         || d_warn "not running as root" "some checks skipped; use sudo"
    if [ "$(id -u)" -eq 0 ]; then
        iptables -L -n >/dev/null 2>&1 && d_ok "iptables usable" \
                                       || d_bad "iptables not usable" "kernel modules missing?"
    fi

    printf '\n  %sconfig%s\n' "$C_DIM" "$C_OFF"
    [ -r "$CONF" ] && d_ok "config file" "$CONF" \
                   || d_warn "config file" "$CONF not found — using built-in defaults"
    if [ -n "$LAN_IF" ] && iface_exists "$LAN_IF"; then
        d_ok "LAN interface" "$LAN_IF ${LAN_IP:+($LAN_IP)}"
    else
        d_bad "LAN interface" "'${LAN_IF:-?}' not found — set LAN_IF in $CONF"
    fi
    [ -n "$LAN_CIDR" ] && d_ok "LAN subnet" "$LAN_CIDR" \
                       || d_bad "LAN subnet" "could not determine — set LAN_CIDR in $CONF"
    if [ -n "$LAN_IP" ] && [ -n "$LAN_CIDR" ]; then
        ip_in_cidr "$LAN_IP" "$LAN_CIDR" && d_ok "Pi's IP is inside LAN_CIDR" \
                                         || d_warn "Pi's IP is outside LAN_CIDR" "$LAN_IP vs $LAN_CIDR"
    fi
    if [ -n "$LAN_IP" ] && ip_is_dhcp "$LAN_IF"; then
        d_warn "LAN IP looks DHCP-assigned" "give the Pi a static IP or clients will break"
    fi

    printf '\n  %stunnel%s\n' "$C_DIM" "$C_OFF"
    if iface_up "$VPN_IF"; then
        d_ok "$VPN_IF is up" "$(vpn_ip)"
        if [ "$(id -u)" -eq 0 ] && have ip; then
            local route
            route="$(ip route get "$WATCHDOG_PING_HOST" 2>/dev/null | head -1)"
            case "$route" in
                *"dev $VPN_IF"*) d_ok "default route uses the tunnel" ;;
                *) d_warn "default route does NOT use the tunnel" "dnsmasq upstream may be blocked" ;;
            esac
        fi
    elif iface_exists "$VPN_IF"; then
        d_warn "$VPN_IF exists but is down" "connect the VPN"
    else
        d_warn "$VPN_IF not present" "connect the VPN, or fix VPN_IF in $CONF"
    fi
    [ -n "$VPN_RESTART_CMD" ] && d_ok "watchdog restart command" "$VPN_RESTART_CMD" \
                              || d_warn "VPN_RESTART_CMD is empty" "watchdog can detect but not fix outages"

    printf '\n  %sbypass routing%s\n' "$C_DIM" "$C_OFF"
    if [ -z "${BYPASS_IPS// /}" ]; then
        d_ok "no bypass clients configured"
    else
        local gw
        gw="${LAN_GATEWAY:-$(detect_lan_gateway)}"
        if [ -z "$gw" ]; then
            d_bad "LAN_GATEWAY unknown" "bypass cannot work — set it in $CONF"
        else
            d_ok "router for bypassed clients" "$gw"
            if state_is_on; then
                local missing=""
                for b in $BYPASS_IPS; do
                    ip rule show priority "$BYPASS_PRIO" 2>/dev/null | grep -q "from $b " ||
                        missing="$missing $b"
                done
                [ -z "$missing" ] && d_ok "ip rules installed" "$(printf '%s' "$BYPASS_IPS" | wc -w) client(s)" \
                                  || d_bad "missing ip rule for:$missing" "run 'vpngw restart'"
                ip route show table "$BYPASS_TABLE" 2>/dev/null | grep -q default \
                    && d_ok "bypass routing table populated" \
                    || d_bad "routing table $BYPASS_TABLE is empty" "run 'vpngw restart'"
            fi
        fi
    fi

    printf '\n  %sDNS%s\n' "$C_DIM" "$C_OFF"
    local holder
    holder="$(dns_port_holder)"
    if [ -z "$holder" ]; then
        d_ok "port 53 is free"
    elif [ "$holder" = dnsmasq ]; then
        d_ok "port 53 held by dnsmasq"
    else
        d_bad "port 53 held by '$holder'" "disable it, or dnsmasq won't start"
    fi
    if [ "$KILL_SWITCH" = yes ] && [ "$DNS_LEAK_GUARD" = yes ]; then
        local clash=""
        for d in $UPSTREAM_DNS; do
            grep -q "^nameserver[[:space:]]*$d\$" /etc/resolv.conf 2>/dev/null && clash="$d"
        done
        [ -n "$clash" ] && d_warn "resolv.conf uses $clash" "the Pi loses DNS when the tunnel drops" \
                        || d_ok "resolv.conf doesn't clash with the leak guard"
    fi

    printf '\n  %sruntime%s\n' "$C_DIM" "$C_OFF"
    if state_is_on; then
        d_ok "gateway is ON"
        [ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" = 1 ] \
            && d_ok "ip_forward enabled" || d_bad "ip_forward is off" "but the gateway is on?"
        svc_active "$DNSMASQ_SERVICE" && d_ok "dnsmasq running" \
                                      || d_bad "dnsmasq not running" "journalctl -u $DNSMASQ_SERVICE"
    else
        d_ok "gateway is OFF" "nothing to check — run 'vpngw on' first"
    fi

    printf '\n'
    if [ "$DOC_FAIL" -gt 0 ]; then
        printf '  %s%d problem(s)%s and %d warning(s)\n\n' "$C_BAD" "$DOC_FAIL" "$C_OFF" "$DOC_WARN"
        return 1
    elif [ "$DOC_WARN" -gt 0 ]; then
        printf '  no blockers, %s%d warning(s)%s\n\n' "$C_WARN" "$DOC_WARN" "$C_OFF"
    else
        printf '  %severything looks good%s\n\n' "$C_OK" "$C_OFF"
    fi
    return 0
}

dns_port_holder() {
    have ss || return 0
    ss -lunpH 2>/dev/null | awk '$5 ~ /:53$/ {
        if (match($0, /users:\(\("[^"]+"/)) {
            s = substr($0, RSTART+8); gsub(/".*/, "", s); print s; exit
        }
    }'
}

ip_is_dhcp() {
    ip -o -4 addr show dev "$1" 2>/dev/null | grep -q "dynamic"
}

ip_in_cidr() {
    local ip="$1" cidr="$2"
    have python3 || return 0
    python3 - "$ip" "$cidr" <<'PY' 2>/dev/null
import ipaddress, sys
try:
    sys.exit(0 if ipaddress.ip_address(sys.argv[1]) in ipaddress.ip_network(sys.argv[2], strict=False) else 1)
except Exception:
    sys.exit(0)
PY
}

# ----------------------------------------------------------------------------
# scan — what's on the LAN right now
# ----------------------------------------------------------------------------
client_state() {
    local ip="$1"
    list_has "$BLOCK_IPS"  "$ip" && { printf 'blocked'; return; }
    list_has "$BYPASS_IPS" "$ip" && { printf 'bypass';  return; }
    printf 'tunnel'
}

cmd_scan() {
    resolve_settings
    printf '\n  %sScanning %s on %s…%s\n' "$C_DIM" "$LAN_CIDR" "$LAN_IF" "$C_OFF"

    # nudge the ARP table: ping the broadcast address, then let replies settle
    ping -c1 -w1 -b "$(broadcast_addr)" >/dev/null 2>&1 || true
    if have nmap; then
        nmap -sn -n --max-retries 1 "$LAN_CIDR" >/dev/null 2>&1 || true
    fi
    sleep 1

    local leases=/var/lib/misc/dnsmasq.leases
    printf '\n  %-16s %-19s %-22s %s\n' "IP" "MAC" "HOSTNAME" "STATE"
    printf '  %s\n' "$(printf '─%.0s' $(seq 1 72))"

    ip -4 neigh show dev "$LAN_IF" 2>/dev/null |
        awk '$3 == "lladdr" && $NF != "FAILED" {print $1, $4}' |
        sort -t. -k4 -n |
        while read -r ip mac; do
            local host="" st col
            [ -f "$leases" ] && host="$(awk -v m="$mac" '$2 == m {print $4; exit}' "$leases")"
            [ -z "$host" ] && host="$(getent hosts "$ip" 2>/dev/null | awk '{print $2; exit}')"
            [ -z "$host" ] || [ "$host" = "*" ] && host="—"

            st="$(client_state "$ip")"
            case "$st" in
                blocked) col="$C_BAD" ;;
                bypass)  col="$C_WARN" ;;
                *)       col="$C_OK" ;;
            esac
            printf '  %-16s %-19s %-22s %s%s%s\n' "$ip" "$mac" "${host:0:22}" "$col" "$st" "$C_OFF"
        done

    printf '\n  %sthis Pi%s          %-19s %-22s %s\n' \
        "$C_DIM" "$C_OFF" "$(cat "/sys/class/net/$LAN_IF/address" 2>/dev/null)" "$(hostname)" "gateway"
    printf '\n  %sblock/bypass any of these with:%s  vpngw block <ip>   vpngw bypass <ip>\n\n' \
        "$C_DIM" "$C_OFF"
}

broadcast_addr() {
    ip -o -4 addr show dev "$LAN_IF" 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="brd"){print $(i+1); exit}}'
}

# ----------------------------------------------------------------------------
# per-client lists
# ----------------------------------------------------------------------------
valid_target() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$ ]]
}

# rewrite KEY="..." in the config file
conf_set() {
    local key="$1" val="$2"
    [ -f "$CONF" ] || die "$CONF does not exist"
    if grep -qE "^[[:space:]]*$key=" "$CONF"; then
        sed -i "s|^[[:space:]]*$key=.*|$key=\"$val\"|" "$CONF"
    else
        printf '%s="%s"\n' "$key" "$val" >> "$CONF"
    fi
}

list_has()  { printf ' %s ' "$1" | grep -qF " $2 "; }
list_add()  { list_has "$1" "$2" && { printf '%s' "$1"; return; }; printf '%s' "${1:+$1 }$2"; }
list_del()  {
    local out=""
    for i in $1; do [ "$i" = "$2" ] || out="${out:+$out }$i"; done
    printf '%s' "$out"
}

# reapply rules if the gateway is currently running
reapply() {
    if state_is_on; then
        fw_apply
        ok "rules reloaded"
    else
        log "gateway is off — takes effect on the next 'vpngw on'"
    fi
}

cmd_list_edit() {
    local var="$1" action="$2" target="${3:-}"
    need_root
    case "$action" in
        user-block|user-unblock)
            [ -n "$target" ] || die "usage: vpngw ${action} <username>"
            id -u "$target" >/dev/null 2>&1 || die "no such local user: '$target'"
            if [ "$(id -u "$target")" -eq 0 ]; then
                die "refusing to block root — it would cut off the Pi itself"
            fi ;;
        *)
            [ -n "$target" ] || die "usage: vpngw ${action} <ip|cidr>"
            valid_target "$target" || die "'$target' is not a valid IPv4 address or CIDR" ;;
    esac
    resolve_settings

    local cur new
    cur="${!var}"
    case "$action" in
        block|bypass|user-block)
            list_has "$cur" "$target" && { warn "$target is already in $var"; exit 0; }
            new="$(list_add "$cur" "$target")" ;;
        unblock|unbypass|user-unblock)
            list_has "$cur" "$target" || { warn "$target is not in $var"; exit 0; }
            new="$(list_del "$cur" "$target")" ;;
    esac

    conf_set "$var" "$new"
    declare -g "$var=$new"

    case "$action" in
        block)        ok "$target blacklisted — no internet through this Pi" ;;
        unblock)      ok "$target un-blacklisted" ;;
        bypass)
            ok "$target will skip the tunnel and use the normal uplink"
            [ -n "${LAN_GATEWAY:-$(detect_lan_gateway)}" ] ||
                warn "LAN_GATEWAY is unknown — set it in $CONF or bypass won't take effect" ;;
        unbypass)     ok "$target goes back through the tunnel" ;;
        user-block)   ok "user '$target' blocked — outbound traffic dropped, SSH login still works" ;;
        user-unblock) ok "user '$target' unblocked" ;;
    esac
    reapply

    if [ "$action" = user-block ]; then
        printf '\n'
        warn "this matches on uid, so anything they run via sudo/root is NOT blocked"
        local n
        n="$(pgrep -u "$target" -c . 2>/dev/null || echo 0)"
        [ "$n" -gt 0 ] && log "'$target' has $n process(es) running — existing connections drop immediately"
        printf '\n'
    fi
}

cmd_clients() {
    resolve_soft
    printf '\n  %sClient rules%s\n\n' "$C_DIM" "$C_OFF"
    printf '  %sBlacklisted%s (no internet at all)\n' "$C_BAD" "$C_OFF"
    if [ -n "${BLOCK_IPS// /}" ]; then
        for b in $BLOCK_IPS; do printf '    %s\n' "$b"; done
    else
        printf '    %s(none)%s\n' "$C_DIM" "$C_OFF"
    fi
    printf '\n  %sBypassing the tunnel%s (normal uplink)\n' "$C_WARN" "$C_OFF"
    if [ -n "${BYPASS_IPS// /}" ]; then
        local gw rules
        gw="${LAN_GATEWAY:-$(detect_lan_gateway)}"
        rules="$(ip rule show priority "$BYPASS_PRIO" 2>/dev/null)"
        for b in $BYPASS_IPS; do
            if printf '%s' "$rules" | grep -q "from $b "; then
                printf '    %s %s(routed via %s)%s\n' "$b" "$C_DIM" "${gw:-?}" "$C_OFF"
            else
                printf '    %s %s← no ip rule active, NOT bypassing%s\n' "$b" "$C_BAD" "$C_OFF"
            fi
        done
        [ -z "$gw" ] && printf '    %sLAN_GATEWAY unknown — set it in %s%s\n' "$C_BAD" "$CONF" "$C_OFF"
    else
        printf '    %s(none)%s\n' "$C_DIM" "$C_OFF"
    fi
    printf '\n  %sBlocked local users%s (can still SSH in, traffic dropped)\n' "$C_BAD" "$C_OFF"
    if [ -n "${BLOCK_USERS// /}" ]; then
        for u in $BLOCK_USERS; do
            if id -u "$u" >/dev/null 2>&1; then
                printf '    %s (uid %s)\n' "$u" "$(id -u "$u")"
            else
                printf '    %s %s(no such user)%s\n' "$u" "$C_WARN" "$C_OFF"
            fi
        done
    else
        printf '    %s(none)%s\n' "$C_DIM" "$C_OFF"
    fi

    printf '\n  Everything else in %s goes through %s\n\n' "${LAN_CIDR:-the LAN}" "$VPN_IF"
}

cmd_enable_boot()  { need_root; systemctl enable "$SERVICE"  && ok "will start at boot"; }
cmd_disable_boot() { need_root; systemctl disable "$SERVICE" && ok "will not start at boot"; }

usage() {
    cat <<EOF

  vpngw — Raspberry Pi LAN VPN gateway

    vpngw on             route LAN clients through $VPN_IF, serve DNS
    vpngw off            remove all rules and stop DNS
    vpngw restart        off + on
    vpngw status         show current state
    vpngw test           check the exit IP and DNS actually use the tunnel
    vpngw doctor         diagnose the whole setup before something breaks
    vpngw scan           list devices on the LAN and how each is routed
    vpngw acct           per-client bandwidth (also: acct reset)

  per-client rules (applied live, no restart needed)

    vpngw block <ip>     blacklist: no internet through this Pi at all
    vpngw unblock <ip>
    vpngw bypass <ip>    skip the tunnel, use the normal uplink instead
    vpngw unbypass <ip>

    vpngw user-block <user>    drop a local account's outbound traffic
    vpngw user-unblock <user>  (they can still log in over SSH)

    vpngw clients        show all three lists

  watchdog (reconnects the VPN when the tunnel dies)

    vpngw watchdog on|off|status

  web dashboard

    vpngw web on|off|status
    vpngw web-passwd     set the dashboard password

  other

    vpngw enable-boot    start automatically on boot
    vpngw disable-boot   don't start on boot
    vpngw config         edit $CONF

EOF
}

case "${1:-status}" in
    on|start|up)       cmd_on ;;
    off|stop|down)     cmd_off ;;
    restart|reload)    cmd_off; cmd_on ;;
    status|st)         cmd_status ;;
    test|check)        cmd_test ;;
    doctor|check-all)  cmd_doctor ;;
    scan|devices)      cmd_scan ;;
    acct|bandwidth|bw) cmd_acct "${2:-show}" ;;
    watchdog)          cmd_watchdog "${2:-status}" ;;
    watchdog-check)    cmd_watchdog_check ;;
    web)               cmd_web "${2:-status}" ;;
    web-passwd)        cmd_web_passwd ;;
    block)             cmd_list_edit BLOCK_IPS  block    "${2:-}" ;;
    unblock)           cmd_list_edit BLOCK_IPS  unblock  "${2:-}" ;;
    bypass)            cmd_list_edit BYPASS_IPS bypass   "${2:-}" ;;
    unbypass)          cmd_list_edit BYPASS_IPS unbypass "${2:-}" ;;
    user-block)        cmd_list_edit BLOCK_USERS user-block   "${2:-}" ;;
    user-unblock)      cmd_list_edit BLOCK_USERS user-unblock "${2:-}" ;;
    clients|list)      cmd_clients ;;
    enable-boot)       cmd_enable_boot ;;
    disable-boot)      cmd_disable_boot ;;
    config|edit)       need_root; "${EDITOR:-nano}" "$CONF" ;;
    -h|--help|help)    usage ;;
    *)                 usage; exit 1 ;;
esac
