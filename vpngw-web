#!/usr/bin/env python3
"""
vpngw-web — tiny local dashboard for the vpngw LAN VPN gateway.

Stdlib only, no dependencies. Reads config from /etc/vpngw.conf and shells out
to the `vpngw` CLI for anything that changes state, so the web layer never
touches iptables itself.

Started/stopped via:  vpngw web on | off
"""

import base64
import hashlib
import html
import http.server
import json
import os
import re
import shlex
import socketserver
import subprocess
import sys
import time

CONF = os.environ.get("VPNGW_CONF", "/etc/vpngw.conf")
PASSWD_FILE = "/etc/vpngw.passwd"
VPNGW = "/usr/local/sbin/vpngw"

# ---------------------------------------------------------------------------
# config
# ---------------------------------------------------------------------------


def load_conf():
    cfg = {
        "LAN_IF": "", "VPN_IF": "xvpn-tun0", "LAN_CIDR": "",
        "WEB_PORT": "8088", "WEB_BIND": "", "WEB_USER": "admin",
        "BLOCK_IPS": "", "BYPASS_IPS": "", "BLOCK_USERS": "",
        "UPSTREAM_DNS": "", "KILL_SWITCH": "yes",
    }
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return cfg


def sh(*args, timeout=20):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except Exception as e:  # noqa: BLE001
        return 1, "", str(e)


def strip_ansi(s):
    return re.sub(r"\033\[[0-9;]*m", "", s)


# ---------------------------------------------------------------------------
# state gathering
# ---------------------------------------------------------------------------


def iface_up(name):
    try:
        with open(f"/sys/class/net/{name}/operstate") as f:
            return f.read().strip() in ("up", "unknown")
    except OSError:
        return False


def gateway_on():
    _, out, _ = sh("iptables", "-S", "FORWARD")
    return "-j VPNGW_FWD" in out


def lan_ip(cfg):
    _, out, _ = sh("ip", "-o", "-4", "addr", "show", "dev", cfg["LAN_IF"], "scope", "global")
    m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", out)
    return m.group(1) if m else ""


def accounting():
    """{ip: {"up": bytes, "down": bytes}} from the VPNGW_ACCT chain."""
    _, out, _ = sh("iptables", "-vnxL", "VPNGW_ACCT")
    data = {}
    # These rules carry no target, so the target column is blank and the field
    # offsets shift. Source/destination are always the last two columns.
    for line in out.splitlines()[2:]:
        f = line.split()
        if len(f) < 6:
            continue
        try:
            byts = int(f[1])
        except ValueError:
            continue
        src, dst = f[-2], f[-1]
        if src != "0.0.0.0/0":
            ip = src.split("/")[0]
            data.setdefault(ip, {"up": 0, "down": 0})["up"] += byts
        if dst != "0.0.0.0/0":
            ip = dst.split("/")[0]
            data.setdefault(ip, {"up": 0, "down": 0})["down"] += byts
    return data


def neighbours(cfg):
    """[(ip, mac, hostname)] currently visible on the LAN."""
    _, out, _ = sh("ip", "-4", "neigh", "show", "dev", cfg["LAN_IF"])
    leases = {}
    try:
        with open("/var/lib/misc/dnsmasq.leases") as f:
            for line in f:
                p = line.split()
                if len(p) >= 4:
                    leases[p[1].lower()] = p[3]
    except OSError:
        pass

    rows = []
    for line in out.splitlines():
        p = line.split()
        if len(p) < 4 or p[1] != "lladdr" or p[-1] == "FAILED":
            continue
        ip, mac = p[0], p[2].lower()
        host = leases.get(mac, "")
        if host in ("*", None):
            host = ""
        rows.append((ip, mac, host))
    rows.sort(key=lambda r: [int(x) for x in r[0].split(".")])
    return rows


def client_state(ip, cfg):
    if ip in cfg["BLOCK_IPS"].split():
        return "blocked"
    if ip in cfg["BYPASS_IPS"].split():
        return "bypass"
    return "tunnel"


def snapshot():
    cfg = load_conf()
    on = gateway_on()
    acct = accounting() if on else {}
    clients = []
    for ip, mac, host in neighbours(cfg):
        a = acct.get(ip, {"up": 0, "down": 0})
        clients.append({
            "ip": ip, "mac": mac, "host": host,
            "state": client_state(ip, cfg),
            "up": a["up"], "down": a["down"],
        })
    # include rule'd hosts that aren't currently in the ARP table
    seen = {c["ip"] for c in clients}
    for ip in cfg["BLOCK_IPS"].split() + cfg["BYPASS_IPS"].split():
        base = ip.split("/")[0]
        if base not in seen:
            a = acct.get(base, {"up": 0, "down": 0})
            clients.append({"ip": base, "mac": "", "host": "", "offline": True,
                            "state": client_state(base, cfg),
                            "up": a["up"], "down": a["down"]})

    _, wd, _ = sh("systemctl", "is-enabled", "vpngw-watchdog.timer")
    return {
        "on": on,
        "lan_if": cfg["LAN_IF"], "lan_ip": lan_ip(cfg), "lan_cidr": cfg["LAN_CIDR"],
        "vpn_if": cfg["VPN_IF"], "tunnel_up": iface_up(cfg["VPN_IF"]),
        "kill_switch": cfg["KILL_SWITCH"], "dns": cfg["UPSTREAM_DNS"],
        "blocked_users": cfg["BLOCK_USERS"].split(),
        "watchdog": wd.strip() == "enabled",
        "clients": clients,
        "ts": int(time.time()),
    }


# ---------------------------------------------------------------------------
# auth
# ---------------------------------------------------------------------------


def check_password(user, pw, cfg):
    if user != cfg["WEB_USER"]:
        return False
    try:
        with open(PASSWD_FILE) as f:
            salt, want = f.read().strip().split("$", 1)
    except (OSError, ValueError):
        return False
    got = hashlib.pbkdf2_hmac("sha256", pw.encode(), salt.encode(), 100_000).hex()
    # constant-time compare
    return hashlib.sha256(got.encode()).digest() == hashlib.sha256(want.encode()).digest()


