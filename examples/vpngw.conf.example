# vpngw configuration
# Copy to /etc/vpngw.conf — install.sh does this automatically with detected
# values on first run. Edit with: sudo vpngw config

# --- network ------------------------------------------------------------

# Pi's ethernet interface (also its uplink to the access point). Leave blank
# to auto-detect.
LAN_IF=""

# LAN subnet, e.g. 192.168.1.0/24. Leave blank to auto-detect.
LAN_CIDR=""

# Your router's IP — where 'vpngw bypass' sends clients instead of the tunnel.
# Auto-detected when possible, but detection fails if your VPN client replaces
# the default route outright. Set it explicitly if 'vpngw clients' reports that
# a bypassed client has no active ip rule.
LAN_GATEWAY=""

# The VPN tunnel interface created by your VPN client.
VPN_IF="xvpn-tun0"

# --- DNS ------------------------------------------------------------------

# Resolvers dnsmasq forwards to. Queried THROUGH the tunnel.
UPSTREAM_DNS="1.1.1.1 9.9.9.9"

DNS_CACHE_SIZE=1000
DNSMASQ_SERVICE=dnsmasq

# --- safety -----------------------------------------------------------

# yes = client traffic is dropped whenever the tunnel is down (no leaks)
KILL_SWITCH=yes

# yes = also block the Pi's OWN queries to UPSTREAM_DNS if they'd leave
# outside the tunnel. Set to no if the Pi's /etc/resolv.conf points at one.
DNS_LEAK_GUARD=yes

# yes = block IPv6 forwarding so clients can't bypass the tunnel over v6
BLOCK_IPV6=yes

# --- per-client rules (usually left blank — managed via the CLI) ------

# vpngw block <ip> / unblock <ip>       — denied entirely, no internet at all
BLOCK_IPS=""

# vpngw bypass <ip> / unbypass <ip>     — skip the tunnel, use normal uplink
# (needs LAN_GATEWAY above; implemented with policy routing, not just firewall)
BYPASS_IPS=""

# Routing table id and ip rule priority used for bypassed clients. Only change
# these if something else on the Pi already uses them.
BYPASS_TABLE=51
BYPASS_PRIO=100

# vpngw user-block <user> / user-unblock <user>
# Local accounts on the Pi whose outbound traffic is dropped. They can still
# log in over SSH — only what they send out is blocked.
BLOCK_USERS=""
SSH_PORT=22

# --- watchdog ---------------------------------------------------------

# Command that brings your VPN back up when the tunnel dies, e.g.
# "xvpn connect" or "systemctl restart xvpn". Leave empty and the watchdog
# still detects and logs outages, it just won't try to fix them.
# Enable with: vpngw watchdog on
VPN_RESTART_CMD=""

# Pinged through the tunnel to prove it actually carries traffic — an
# interface being "up" isn't enough.
WATCHDOG_PING_HOST="1.1.1.1"

# Consecutive failed checks before the restart command runs (checks are 60s
# apart, so 2 means roughly two minutes of downtime before acting).
WATCHDOG_FAILS_BEFORE_ACTION=2

# Seconds to wait after a restart before checking again, so a VPN that's
# slow to connect doesn't get restarted in a loop.
WATCHDOG_COOLDOWN=120

# --- web dashboard ----------------------------------------------------

# Set a password with 'vpngw web-passwd', then: vpngw web on
WEB_PORT=8088
WEB_BIND=""          # defaults to the Pi's LAN IP; "0.0.0.0" to listen on all
WEB_USER="admin"
